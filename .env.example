# Copy to .env and source it for a self-hosted API. Never commit real values.
ASSET_STUDIO_API_KEY=
ASSET_STUDIO_SIGNING_SECRET=
ASSET_STUDIO_PUBLIC_BASE_URL=https://api.example.com
ASSET_STUDIO_RATE_LIMIT=120
ASSET_STUDIO_STORAGE=local

# Optional S3-compatible object storage (see docs/storage.md)
ASSET_STUDIO_S3_BUCKET=
ASSET_STUDIO_S3_ENDPOINT=
ASSET_STUDIO_S3_REGION=us-east-1
ASSET_STUDIO_S3_ACCESS_KEY=
ASSET_STUDIO_S3_SECRET_KEY=
