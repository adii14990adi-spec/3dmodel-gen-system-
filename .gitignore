# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
.coverage

# Generated outputs (never commit) — SOURCE assets under assets/ ARE committed,
# because their paths trigger the GitHub Actions processing workflows.
# The small A-L verification fixtures in assets/ are generated by
# scripts/generate_sample_assets.py and are intentionally tracked as test data.
local/
processed/
manifests/
reports/
sample-assets/*.glb
sample-assets/*.bvh
sample-assets/*.fbx
sample-assets/*.png
*.db
*.db-journal
*.sqlite3
*.log
tools/gltf-validator/node_modules/

# Android
android/.gradle/
android/build/
android/*/build/
android/local.properties
android/keystore.properties
*.jks
*.keystore
*.apk
*.aab
.cxx/
.externalNativeBuild/

# Secrets / environment
.env
.env.*
!.env.example
*.pem
*.key

# Editors / OS
.idea/
.vscode/
.DS_Store
